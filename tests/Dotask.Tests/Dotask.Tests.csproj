<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DoTask.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildProjectDirectory)/../.." />
    <EmbeddedResource Include="../../.tasks/verify.rs;../../.tasks/verify-docs.rs;../../.tasks/catalog.rs"
                      LogicalName="RepositoryTasks/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../build.sh;../../build.cmd;../../.tasks/misc/bootstrap.targets"
                      LogicalName="Bootstrap/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../.tasks/misc/prepare-bootstrap.ps1" LogicalName="Bootstrap/prepare-bootstrap.ps1" />
    <EmbeddedResource Include="../../shared-tasks/**/*">
      <!-- Resource identifiers are portable names, not platform filesystem paths. -->
      <LogicalName>$([System.String]::Copy('Shared/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../.tasks/_/**/*.cs;../../.tasks/_/**/*.rs">
      <LogicalName>$([System.String]::Copy('InstalledShared/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="../../src/Dotask.Cli/Dotask.Cli.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
