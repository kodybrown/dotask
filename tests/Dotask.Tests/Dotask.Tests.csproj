<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DoTask.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
