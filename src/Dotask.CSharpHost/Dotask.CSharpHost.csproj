<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>DoTask.CSharpHost</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dotask/Dotask.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Share the reference implementation while porting. This host has no CLI
         dispatcher, task executor, management commands, or dependency on dotask.dll. -->
    <Compile Include="../Dotask.Cli/Metadata/MetadataReader.cs;../Dotask.Cli/Metadata/TargetDefinition.cs" Link="Metadata/%(Filename)%(Extension)" />
    <Compile Include="../Dotask.Cli/Execution/TargetCompiler.cs;../Dotask.Cli/Execution/DotnetHost.cs"
             Link="Execution/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
